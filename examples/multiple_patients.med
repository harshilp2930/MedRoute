// multiple_patients.med
// MedRoute Example 2 — Multi-patient, multi-ambulance scenario
// ============================================================

// Register three patients
PATIENT P101
LOCATION P101 "Sardar Patel Road"
SEVERITY P101 CRITICAL

PATIENT P102
LOCATION P102 "MG Road Junction"
SEVERITY P102 HIGH

PATIENT P103
LOCATION P103 "Railway Station"
SEVERITY P103 MEDIUM

// Register ambulances
AMBULANCE A12
DISTANCE A12 P101 5
SPEED A12 30

AMBULANCE A13
DISTANCE A13 P102 3
SPEED A13 30

AMBULANCE A14
DISTANCE A14 P103 8
SPEED A14 40

// Register hospitals
HOSPITAL H01 "City Hospital"
HOSPITAL H02 "Apollo Medical Centre"

// Dispatch critical patient first (HIGH priority)
DISPATCH A12 P101
ROUTE A12 H01
PRIORITY A12 HIGH

// Dispatch second patient
DISPATCH A13 P102
ROUTE A13 H01
PRIORITY A13 HIGH

// Dispatch third patient
DISPATCH A14 P103
ROUTE A14 H02
PRIORITY A14 MEDIUM

// Status check all ambulances
STATUS A12
STATUS A13
STATUS A14

// Ambulances proceed directly to dispatch -> transfer state

// Transfer patients to hospitals
TRANSFER P101 H01
TRANSFER P102 H01
TRANSFER P103 H02

// Final report
REPORT
