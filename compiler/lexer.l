%{
  /**
 * lexer.l
 * MedRoute Compiler - Flex Lexical Analyzer
 * ============================================================
 * Recognizes all MedRoute tokens: keywords, identifiers,
 * string literals, severity/priority values, and comments.
 * Outputs a JSON token stream to stdout when invoked with
 * the --tokens flag (handled in main.c).
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "parser.tab.h"   /* generated by Bison */

  /* Line tracking */
int yylineno_val = 1;

  /* Token list for JSON output */
#define MAX_TOKENS 4096

typedef struct Token {
    int         line;
    char        lexeme[512];
    char        type[64];
} Token;

Token   g_tokens[MAX_TOKENS];
int     g_token_count = 0;

static void _record_token(const char *lexeme, const char *type) {
    if (g_token_count >= MAX_TOKENS) return;
    g_tokens[g_token_count].line = yylineno_val;
    strncpy(g_tokens[g_token_count].lexeme, lexeme, 511);
    strncpy(g_tokens[g_token_count].type,   type,   63);
    g_token_count++;
}

  /* Copy string literal without surrounding quotes */
static char* strip_quotes(const char *s) {
    static char buf[512];
    int len = strlen(s);
    strncpy(buf, s + 1, len - 2);
    buf[len - 2] = '\0';
    return buf;
}
%}

%option noyywrap
%option yylineno

  /* ============================================================
 * DEFINITIONS
 * ============================================================ */
DIGIT       [0-9]
LETTER      [A-Za-z]
ID          [A-Z][A-Z0-9_]*
STRING      \"([^\"\\]|\\.)*\"
INTEGER     {DIGIT}+
FLOAT       {DIGIT}+\.{DIGIT}+
COMMENT     \/\/[^\n]*
WHITESPACE  [ \t\r]+

%%

{COMMENT}   { /* Ignore single-line comments */ }

{WHITESPACE} { /* Ignore whitespace */ }

\n          { yylineno_val++; }

  /* ============================================================
 * KEYWORDS
 * ============================================================ */
"PATIENT"   { _record_token(yytext, "KEYWORD_PATIENT");   return TOK_PATIENT;   }
"LOCATION"  { _record_token(yytext, "KEYWORD_LOCATION");  return TOK_LOCATION;  }
"SEVERITY"  { _record_token(yytext, "KEYWORD_SEVERITY");  return TOK_SEVERITY;  }
"AMBULANCE" { _record_token(yytext, "KEYWORD_AMBULANCE"); return TOK_AMBULANCE; }
"HOSPITAL"  { _record_token(yytext, "KEYWORD_HOSPITAL");  return TOK_HOSPITAL;  }
"DISPATCH"  { _record_token(yytext, "KEYWORD_DISPATCH");  return TOK_DISPATCH;  }
"ROUTE"     { _record_token(yytext, "KEYWORD_ROUTE");     return TOK_ROUTE;     }
"PRIORITY"  { _record_token(yytext, "KEYWORD_PRIORITY");  return TOK_PRIORITY;  }
"STATUS"    { _record_token(yytext, "KEYWORD_STATUS");    return TOK_STATUS;    }
"DISTANCE"  { _record_token(yytext, "KEYWORD_DISTANCE");  return TOK_DISTANCE;  }
"TRANSFER"  { _record_token(yytext, "KEYWORD_TRANSFER");  return TOK_TRANSFER;  }
"SPEED"     { _record_token(yytext, "KEYWORD_SPEED");     return TOK_SPEED;     }
"REGISTER"  { _record_token(yytext, "KEYWORD_REGISTER");  return TOK_REGISTER;  }
"AVAILABLE" { _record_token(yytext, "KEYWORD_AVAILABLE"); return TOK_AVAILABLE; }
"ASSIGN"    { _record_token(yytext, "KEYWORD_ASSIGN");    return TOK_ASSIGN;    }
"REPORT"    { _record_token(yytext, "KEYWORD_REPORT");    return TOK_REPORT;    }

  /* ============================================================
 * SEVERITY TOKENS
 * ============================================================ */
"CRITICAL"  { _record_token(yytext, "SEVERITY_CRITICAL"); return TOK_CRITICAL;  }
"HIGH"      { _record_token(yytext, "PRIORITY_HIGH");     return TOK_HIGH;      }
"MEDIUM"    { _record_token(yytext, "PRIORITY_MEDIUM");   return TOK_MEDIUM;    }
"LOW"       { _record_token(yytext, "PRIORITY_LOW");      return TOK_LOW;       }

  /* ============================================================
 * STRING LITERAL
 * ============================================================ */
{STRING}    {
    char *stripped = strip_quotes(yytext);
    _record_token(yytext, "STRING");
    yylval.str_val = strdup(stripped);
    return TOK_STRING;
}

  /* ============================================================
 * NUMBER
 * ============================================================ */
{FLOAT}     {
    _record_token(yytext, "FLOAT");
    yylval.float_val = atof(yytext);
    return TOK_FLOAT;
}

{INTEGER}   {
    _record_token(yytext, "INTEGER");
    yylval.int_val = atoi(yytext);
    return TOK_INTEGER;
}

  /* ============================================================
 * OPERATORS
 * ============================================================ */
"=="        { _record_token(yytext, "OP_EQ");  return TOK_EQ;  }
"!="        { _record_token(yytext, "OP_NEQ"); return TOK_NEQ; }
">="        { _record_token(yytext, "OP_GTE"); return TOK_GTE; }
"<="        { _record_token(yytext, "OP_LTE"); return TOK_LTE; }
">"         { _record_token(yytext, "OP_GT");  return TOK_GT;  }
"<"         { _record_token(yytext, "OP_LT");  return TOK_LT;  }
"="         { _record_token(yytext, "OP_ASSIGN"); return TOK_ASSIGN_OP; }

  /* ============================================================
 * IDENTIFIER (must come AFTER all keywords)
 * ============================================================ */
{ID}        {
    _record_token(yytext, "IDENTIFIER");
    yylval.str_val = strdup(yytext);
    return TOK_IDENTIFIER;
}

  /* ============================================================
 * UNKNOWN CHARACTER — Lexical Error
 * ============================================================ */
.           {
    char msg[128];
    snprintf(msg, sizeof(msg),
             "LEXICAL_ERROR: Unknown character '%s' at line %d",
             yytext, yylineno_val);
    fprintf(stderr, "%s\n", msg);
  /* Record as error token */
    _record_token(yytext, "LEXICAL_ERROR");
}

%%

  /* ============================================================
 * TOKEN JSON DUMP
 * ============================================================ */
void tokens_dump_json(FILE *out) {
    fprintf(out, "[\n");
    for (int i = 0; i < g_token_count; i++) {
        if (i > 0) fprintf(out, ",\n");
  /* Escape any double-quotes in lexeme */
        char safe[1024] = {0};
        int si = 0;
        for (int j = 0; g_tokens[i].lexeme[j] && si < 1020; j++) {
            if (g_tokens[i].lexeme[j] == '"')  { safe[si++] = '\\'; safe[si++] = '"'; }
            else                                 { safe[si++] = g_tokens[i].lexeme[j]; }
        }
        fprintf(out,
            "  {\"line\":%d,\"lexeme\":\"%s\",\"type\":\"%s\"}",
            g_tokens[i].line, safe, g_tokens[i].type);
    }
    fprintf(out, "\n]\n");
}
