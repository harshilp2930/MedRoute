Grammar

    0 $accept: program $end

    1 program: statement_list

    2 statement_list: statement
    3               | statement_list statement

    4 statement: patient_stmt
    5          | location_stmt
    6          | severity_stmt
    7          | ambulance_stmt
    8          | hospital_stmt
    9          | dispatch_stmt
   10          | route_stmt
   11          | priority_stmt
   12          | status_stmt
   13          | arrive_stmt
   14          | transfer_stmt
   15          | cancel_stmt
   16          | report_stmt
   17          | error

   18 patient_stmt: TOK_PATIENT TOK_IDENTIFIER
   19             | TOK_PATIENT error

   20 location_stmt: TOK_LOCATION TOK_IDENTIFIER TOK_STRING
   21              | TOK_LOCATION error

   22 severity_stmt: TOK_SEVERITY TOK_IDENTIFIER severity_val
   23              | TOK_SEVERITY error

   24 severity_val: TOK_LOW
   25             | TOK_MEDIUM
   26             | TOK_HIGH
   27             | TOK_CRITICAL

   28 ambulance_stmt: TOK_AMBULANCE TOK_IDENTIFIER
   29               | TOK_AMBULANCE error

   30 hospital_stmt: TOK_HOSPITAL TOK_IDENTIFIER TOK_STRING
   31              | TOK_HOSPITAL error

   32 dispatch_stmt: TOK_DISPATCH TOK_IDENTIFIER TOK_IDENTIFIER
   33              | TOK_DISPATCH TOK_IDENTIFIER
   34              | TOK_DISPATCH error

   35 route_stmt: TOK_ROUTE TOK_IDENTIFIER TOK_IDENTIFIER
   36           | TOK_ROUTE error

   37 priority_stmt: TOK_PRIORITY TOK_IDENTIFIER priority_val
   38              | TOK_PRIORITY error

   39 priority_val: TOK_LOW
   40             | TOK_MEDIUM
   41             | TOK_HIGH

   42 status_stmt: TOK_STATUS TOK_IDENTIFIER
   43            | TOK_STATUS error

   44 arrive_stmt: TOK_ARRIVE TOK_IDENTIFIER
   45            | TOK_ARRIVE error

   46 transfer_stmt: TOK_TRANSFER TOK_IDENTIFIER TOK_IDENTIFIER
   47              | TOK_TRANSFER error

   48 cancel_stmt: TOK_CANCEL TOK_IDENTIFIER
   49            | TOK_CANCEL error

   50 report_stmt: TOK_REPORT


