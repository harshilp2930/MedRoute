# MedRoute Compiler - Makefile
# ============================================================
# Builds the medroute binary using Flex and Bison.
# Prerequisites: flex, bison, gcc
#
# Usage:
#   make          -> build
#   make clean    -> remove build artifacts
#   make test     -> run all .med examples
# ============================================================

CC      = gcc
CFLAGS  = -Wall -Wextra -g -I.
TARGET  = medroute

# Sources generated by Flex/Bison + hand-written C
SRCS = parser.tab.c lex.yy.c \
       symbol_table.c semantic.c \
       intermediate.c executor.c \
       main.c

.PHONY: all clean test

all: $(TARGET)

## Step 1: Generate parser from Bison grammar
parser.tab.c parser.tab.h: parser.y
	bison -d -v parser.y

## Step 2: Generate lexer from Flex rules
lex.yy.c: lexer.l parser.tab.h
	flex lexer.l

## Step 3: Link everything into the final binary
$(TARGET): $(SRCS)
	$(CC) $(CFLAGS) -o $@ $(SRCS)

## Run the example .med files
test: $(TARGET)
	@echo "========================================"
	@echo "TEST 1: Critical Emergency (should PASS)"
	@echo "========================================"
	./$(TARGET) ../examples/critical_emergency.med
	@echo ""
	@echo "========================================"
	@echo "TEST 2: Multiple Patients (should PASS)"
	@echo "========================================"
	./$(TARGET) ../examples/multiple_patients.med
	@echo ""
	@echo "========================================"
	@echo "TEST 3: Syntax Errors (should FAIL)"
	@echo "========================================"
	./$(TARGET) ../examples/syntax_errors.med || true
	@echo ""
	@echo "========================================"
	@echo "TEST 4: Semantic Errors (should FAIL)"
	@echo "========================================"
	./$(TARGET) ../examples/semantic_errors.med || true

clean:
	rm -f $(TARGET) parser.tab.c parser.tab.h lex.yy.c \
	      parser.output *.o
